          "intervalFactor": 2,
          "measurement": "docker_container_net",
          "policy": "default",
          "query": "from(bucket: \"docker_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"docker_container_net\" and r._field =~ /(tx|rx)_bytes/ and r.host == \"${host}\" and r[\"com.docker.compose.service\"] =~ /${container:regex}/)\n  |> keep(columns: [\"_time\", \"_field\", \"_value\", \"name\", \"com.docker.compose.service\"])\n  |> aggregateWindow(every: ${inter}, fn: mean, createEmpty: true)\n  |> derivative(unit: 1s, nonNegative: true)\n  |> map(fn: (r) => ({r with _value: r._value*8.0}))\n  |> yield(name: \"read\")",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series",
          "select": [
            [
              {
                "params": [
                  "tx_bytes"
                ],
                "type": "field"
              },
              {
                "params": [],
                "type": "mean"
              },
              {
                "params": [
                  "10s"
                ],
                "type": "derivative"
              }
            ]
          ],
          "tags": [
            {
              "key": "host",
              "operator": "=~",
              "value": "/^$host$/"
            }
          ]
        }
      ],
      "title": "Network overview for $host",
