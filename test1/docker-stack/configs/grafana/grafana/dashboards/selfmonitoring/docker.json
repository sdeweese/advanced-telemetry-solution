        {
          "alias": "[[tag_com.docker.compose.service]] tx",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdbFlux"
          },
          "dsType": "influxdb",
          "expr": "",
          "groupBy": [
            {
              "params": [
                "$interval"
              ],
              "type": "time"
            },
            {
              "params": [
                "container_name"
              ],
