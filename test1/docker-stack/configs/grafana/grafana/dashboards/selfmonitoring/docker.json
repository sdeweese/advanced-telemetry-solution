          },
          "query": "from(bucket: \"docker_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"docker_container_health\")\n  |> filter(fn: (r) => r[\"host\"] == \"${host}\")\n  |> filter(fn: (r) => r[\"_field\"] == \"health_status\")\n  |> keep(columns: [\"_time\", \"_field\", \"_value\", \"com.docker.compose.service\"])\n  |> aggregateWindow(every: ${inter}, fn: last, createEmpty: true)",
          "refId": "A"
        }
      ],
      "title": "Container health",
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "health_status (.*)",
            "renamePattern": "$1"
          }
        }
      ],
      "transparent": true,
      "type": "state-timeline"
    },
