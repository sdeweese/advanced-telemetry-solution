          "datasource": {
            "type": "influxdb",
            "uid": "influxdbFlux"
          },
          "hide": false,
          "query": "import \"experimental/aggregate\"\n\n\nfrom(bucket: \"kafka_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"host\"] == \"${host}\")\n  |> filter(fn: (r) => r[\"_measurement\"] == \"kafka_topic_partition_current_offset\")\n  |> filter(fn: (r) => r[\"topic\"] != \"__consumer_offsets\")\n  |> keep(columns:[\"_time\", \"_measurement\", \"_value\", \"topic\", \"partition\"])\n  |> aggregate.rate(every: ${inter}, unit: 1s, groupColumns: [\"topic\", \"partition\"])\n  |> tail(n: 1000, offset: 1)\n  |> yield(name: \"mean\")",
          "refId": "A"
        }
      ],
      "title": "Topic partition messages produced per second",
      "type": "timeseries"
